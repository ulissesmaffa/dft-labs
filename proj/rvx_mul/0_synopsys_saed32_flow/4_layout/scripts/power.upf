create_supply_net VSS
create_supply_net VDD
create_supply_net VDDIO
create_supply_net VSSIO

create_supply_set ss_low -function {power VDD} -function {ground VSS }

create_power_domain PD_TOP  -supply {primary ss_low}

create_supply_port VDD -direction in
create_supply_port VSS -direction in
create_supply_port VDDIO -direction in
create_supply_port VSSIO -direction in

connect_supply_net VDD -ports VDD
connect_supply_net VSS -ports VSS
connect_supply_net VSSIO -ports VSSIO
connect_supply_net VDDIO -ports VDDIO

set_design_attributes -elements {.} -attribute correlated_supply_group {*}
add_power_state -supply ss_low  -state ON  { -supply_expr { power == {FULL_ON 0.75 0.75 0.95} && ground == {FULL_ON 0.0} } }

create_power_state_group PST
add_power_state -group PST \
        -state RUN   {-logic_expr { ss_low==ON }}

