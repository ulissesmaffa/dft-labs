# Implemented: partial_supplies

set_design_attributes -elements . -internal_attribute _mv_data_file_version 1
create_power_domain main_domain -include_scope
create_supply_net -domain main_domain VDD
create_supply_port VDD -domain main_domain -direction in
connect_supply_net VDD -ports {VDD}
create_supply_net -domain main_domain VSS
create_supply_port VSS -domain main_domain -direction in
connect_supply_net VSS -ports {VSS}
create_supply_net -domain main_domain VDDIO
create_supply_port VDDIO -domain main_domain -direction in
connect_supply_net VDDIO -ports {VDDIO}
create_supply_net -domain main_domain VSSIO
create_supply_port VSSIO -domain main_domain -direction in
connect_supply_net VSSIO -ports {VSSIO}
set_domain_supply_net main_domain -primary_power_net VDD -primary_ground_net VSS

## Constraints below are generated by snps. Please do not modify.
set derived_upf true

if ($derived_upf) {

set_design_attributes -elements . -internal_attribute _mv_data_status ready
set_design_attributes -elements . -internal_attribute _ldi_supply_nets {VDD \
    VDDIO VSS VSSIO} -internal_attribute _ldi_domains {{main_domain+VDD+VSS}}
set_design_attributes -elements . -internal_attribute \
    _disallow_fwd_biasing_domains { main_domain+false }
set_design_attributes -elements . -internal_attribute \
    _disallow_rvs_biasing_domains { main_domain+false }

}
set derived_upf false
